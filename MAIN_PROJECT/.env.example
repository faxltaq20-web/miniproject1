# ─── Gemini Multi-Key Setup ──────────────────────────────────────────
# Add up to 5 Gemini API keys from different accounts.
# Keys are tried in order. If Key_1 hits rate limit → Key_2 → Key_3 etc.
# 5 keys = 100 free requests/day (20 per key × 5 keys)
# Get your key at: https://aistudio.google.com/apikey

GEMINI_KEY_1=your-gemini-api-key-here
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=

# ─── Model ───────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash

# ─── General ─────────────────────────────────────────────────────────
CONTACT_EMAIL=your-email@example.com
